{
  "name": "floodbank",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test server/services/rules.test.js server/data/localization.test.js",
    "check:i18n": "node scripts/check-i18n.js",
    "translate": "node scripts/translate.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
